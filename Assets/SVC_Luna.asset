            u_xlat9;\nmediump float u_xlat16_11;\nvoid main()\n{\n    u_xlat0.x =
            _OutlineWidth * _ScaleRatioA;\n    u_xlat0.x = u_xlat0.x * vs_TEXCOORD1.y;\n   
