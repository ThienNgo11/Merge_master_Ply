            u_xlat14 = dot(u_xlat2.xyz, u_xlat2.xyz);\n    u_xlat14 = texture(_LightTexture0,
            vec2(u_xlat14)).x;\n    u_xlat16_11.xyz = vec3(u_xlat14) * _LightColor0.xyz;\n   
