            = u_xlat16_12.xyz * u_xlat16_5.xxx + _SpecColor.xyz;\n    u_xlat0.xzw
            = u_xlat0.xzw * u_xlat16_5.xyz;\n    u_xlat16_5.x = max(_SpecColor.y,
            _SpecColor.x);\n    u_xlat16_5.x = max(u_xlat16_5.x, _SpecColor.z);\n   
