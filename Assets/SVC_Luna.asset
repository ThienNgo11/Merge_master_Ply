            u_xlat2;\nmediump vec3 u_xlat16_2;\nvec3 u_xlat3;\nmediump vec3 u_xlat16_4;\nmediump
            vec3 u_xlat16_5;\nmediump float u_xlat16_6;\nfloat u_xlat7;\nfloat u_xlat8;\nmediump
