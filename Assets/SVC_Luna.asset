            vs_TEXCOORD0.xy).xyz;\n    u_xlat2.xyz = u_xlat16_2.xyz * _Color.xyz;\n   
            u_xlat16_5.xyz = u_xlat16_5.xxx * u_xlat2.xyz;\n    u_xlat16_26 = u_xlat16_4.x
            * u_xlat16_4.x;\n    u_xlat16_26 = u_xlat16_26 * u_xlat16_26;\n    u_xlat16_4.x
