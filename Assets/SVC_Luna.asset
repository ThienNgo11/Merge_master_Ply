            + 1.0;\n    u_xlat16_12.x = u_xlat16_5.x * u_xlat16_5.x;\n    u_xlat16_12.x
            = u_xlat16_12.x * u_xlat16_12.x;\n    u_xlat16_5.x = u_xlat16_5.x * u_xlat16_12.x;\n   
